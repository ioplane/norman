# Go 1.27.3, Debian trixie; immutable official Go image.
FROM docker.io/library/golang@sha256:1896654cfc5c2b5ad74c07f29cb36f5d2d1cbed42e3054070fbfe444e521e83c

ARG SOURCE_REVISION
ARG BUILD_CREATED
LABEL org.opencontainers.image.title="Norman Go development" \
      org.opencontainers.image.description="Pinned Norman development toolchain" \
      org.opencontainers.image.source="https://github.com/ioplane/norman" \
      org.opencontainers.image.revision="$SOURCE_REVISION" \
      org.opencontainers.image.created="$BUILD_CREATED" \
      org.opencontainers.image.version="go1.27.3" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.base.name="docker.io/library/golang:1.27.3-trixie" \
      org.opencontainers.image.base.digest="sha256:1896654cfc5c2b5ad74c07f29cb36f5d2d1cbed42e3054070fbfe444e521e83c"

ENV GOTOOLCHAIN=local \
    GOENV=off \
    GOFLAGS="-mod=readonly -buildvcs=false" \
    GOCACHE=/cache/build \
    GOMODCACHE=/cache/modules \
    CGO_ENABLED=1
WORKDIR /src
